<!-- Seção que apresenta a mensagem de erro ao usuário. -->
<section class="mensagem-sistema">
   <!-- Exibe o código HTTP 404, que indica que algo não foi encontrado. -->
  <p class="codigo-erro">404</p>
  <!-- Exibe o título recebido pela rota. -->
  <h1>{{titulo}}</h1>
  <!-- Informa que o espaço ou endereço solicitado não foi encontrado. -->
  <p>O espaço ou endereço solicitado não foi encontrado.</p>
  <!-- Link que permite voltar para a página de listagem dos espaços. -->
  <a class="botao" href="/espacos">Voltar para os espaços</a>
</section>
