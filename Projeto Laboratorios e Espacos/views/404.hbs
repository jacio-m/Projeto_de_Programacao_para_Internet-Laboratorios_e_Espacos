{{!-- pagina 404 com composicao horizontal (404 na esquerda e texto na direita) conforme wireframe 04 --}}
<section class="mensagem-sistema mensagem-sistema--horizontal">
  <p class="codigo-erro">404</p>
  <div class="mensagem-sistema__conteudo">
    <h1>{{titulo}}</h1>
    <p>
      O endereço ou identificador informado (<code>{{caminho}}</code>) não corresponde a um registro disponível.
      Retorne e escolha outro espaço.
    </p>
    <a class="botao" href="/espacos">Voltar para a listagem</a>
  </div>
</section>
