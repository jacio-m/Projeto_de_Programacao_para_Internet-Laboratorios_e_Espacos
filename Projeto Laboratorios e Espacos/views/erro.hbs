<!-- Seção que apresenta a mensagem de erro do sistema. -->
<section class="mensagem-sistema">
<!-- Exibe o código HTTP 500, que indica um erro interno no servidor. -->
  <p class="codigo-erro">500</p>
   <!-- Exibe o título enviado pela aplicação. -->
  <h1>{{titulo}}</h1>
    <!-- Exibe a mensagem explicando o erro ocorrido. -->
  <p>{{mensagem}}</p>
  <!-- Link que permite ao usuário voltar para a página inicial. -->
  <a class="botao" href="/">Voltar ao início</a>
</section>
