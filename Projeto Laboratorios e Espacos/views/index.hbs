{{!-- faixa principal em estilo painel seguindo o wireframe 01 --}}
<section class="hero">
  <p class="rotulo">Painel de laboratórios e espaços</p>
  <h1>{{titulo}}</h1>
  <p class="hero__subtitulo">{{subtitulo}}</p>
  <p>
    Consulte laboratórios, salas especializadas e espaços coletivos do campus.
    Confira a localização, a capacidade, os recursos e a situação de cada espaço.
  </p>
  <a class="botao botao--claro" href="/espacos">Conhecer os espaços</a>
</section>

{{!-- secao com os 3 espacos em destaque vindos do banco de dados --}}
<section class="painel" aria-labelledby="destaques">
  <h2 id="destaques">Espaços em destaque</h2>

  {{#if espacos.length}}
    <div class="grade">
      {{#each espacos}}
        <article class="cartao cartao--destaque">
          <div class="cartao__topo">
            <span class="categoria">Espaço em destaque</span>
            <span class="situacao {{classeSituacao situacao}}">{{situacao}}</span>
          </div>
          <h3>{{nome}}</h3>
          <p><strong>Localização:</strong> {{localizacao}}</p>
          <p><strong>Capacidade:</strong> {{capacidade}} pessoas</p>
          <footer class="cartao__rodape">
            <a class="botao-contorno" href="/espacos/{{id}}">Ver detalhes</a>
          </footer>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p>Nenhum registro foi encontrado.</p>
  {{/if}}
</section>
