{{!-- partial reutilizavel para cada cartao vertical da listagem (wireframe 02) --}}
<article class="cartao">
  <div class="cartao__icone" aria-hidden="true">
    <span>{{iconeEspaco nome}}</span>
  </div>

  <h2>{{nome}}</h2>
  <p><strong>Localização:</strong> {{localizacao}}</p>
  <p><strong>Capacidade:</strong> {{capacidade}} pessoas</p>
  <p><strong>Recursos:</strong> {{recursos}}</p>

  <div class="cartao__situacao">
    <span class="situacao {{classeSituacao situacao}}">{{situacao}}</span>
  </div>

  <footer class="cartao__rodape">
    <span class="identificador">#{{id}}</span>
    <a class="botao-contorno" href="/espacos/{{id}}">Ver detalhes</a>
  </footer>
</article>
