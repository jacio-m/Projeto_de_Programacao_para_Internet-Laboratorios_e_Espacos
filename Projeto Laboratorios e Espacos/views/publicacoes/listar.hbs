```hbs
<!-- Cabeçalho da página de consulta dos espaços. -->
<header class="titulo-pagina">

  <!-- Texto que identifica a finalidade da página. -->
  <p class="rotulo">Consulta de espaços</p>

  <!-- Exibe o título recebido pela rota. -->
  <h1>{{titulo}}</h1>

  <!-- Apresenta uma breve orientação ao usuário. -->
  <p>Confira os laboratórios e espaços disponíveis no campus.</p>

  <!-- Exibe a quantidade de espaços encontrados. -->
  <p class="contador">
    <strong>{{quantidade}}</strong> espaço(s) encontrado(s).
  </p>
</header>

<!-- Verifica se existem espaços cadastrados para exibição. -->
{{#if possuiEspacos}}

  <!-- Seção que organiza os espaços em uma grade. -->
  <section class="grade" aria-label="Lista de espaços">

    <!-- Percorre a lista de espaços recebida pela página. -->
    {{#each espacos}}

      <!-- Reutiliza o cartão definido no arquivo cartao-espaco.hbs. -->
      {{> cartao-espaco}}

    <!-- Finaliza a repetição dos espaços. -->
    {{/each}}
  </section>

<!-- Exibe esta seção quando não existem espaços cadastrados. -->
{{else}}
  <section class="estado-vazio">

    <!-- Título apresentado quando a lista está vazia. -->
    <h2>Nenhum espaço cadastrado</h2>

    <!-- Informa que não há dados disponíveis para exibição. -->
    <p>O banco de dados ainda não possui espaços para apresentar.</p>
  </section>
{{/if}}
```
